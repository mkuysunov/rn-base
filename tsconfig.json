{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@assets/*": ["./assets/*"]
    },
    "types": ["jest"]
  },
  "include": [
    "src/**/*",
    "index.ts",
    "*.config.js",
    "jest.setup.js",
    "tamagui.config.ts"
  ],
  "exclude": ["node_modules", "android", "ios", "dist", ".expo"]
}
